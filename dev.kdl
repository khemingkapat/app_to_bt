layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }

    // Tab 1: Editor
    tab name="editor" focus=true {
        pane command="nix" {
            args "develop"
        }
    }

    tab name="agy" {
        pane command="nix" {
            args "develop" "--command" "agy" "-c"
        }
    }

    tab name="lazygit" {
        pane command="nix" {
            args "develop" "--command" "lazygit"
        }
    }

    tab name="terminal" {
	pane command="nix" {
	    args "develop"
	}
    }
}
